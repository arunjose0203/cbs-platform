# Local development only. Copy to .env and replace the placeholder.
# Docker Compose reads this file; Java requires these as environment variables.
CBS_DB_PASSWORD=replace-with-a-local-random-password
CBS_DB_URL=jdbc:postgresql://localhost:5433/cbs_control
CBS_DB_USER=cbs_control

# APIs remain closed until an external JWT issuer is configured.
CBS_SECURITY_ENABLED=false
# Development only: explicit loopback HTTP identity exception; keep false when deployed.
CBS_ALLOW_LOCAL_IDENTITY_HTTP=false
# Normally empty. Only a named local development administrator can use this expiring exception.
CBS_LOCAL_MFA_BYPASS_UNTIL=
CBS_JWT_ISSUER=
CBS_JWT_JWKS_URI=
CBS_JWT_AUDIENCE=
CBS_BOOTSTRAP_ADMIN_SUBJECT=
# Personal-data field key: Base64 of 32 random bytes. Blank uses an insecure development key.
CBS_PRIVACY_FIELD_KEY=
# Provider delivery-receipt HMAC secret (32+ characters); blank disables the receipt webhook.
CBS_NOTIFICATIONS_CALLBACK_SECRET=
# P-07 daily cycle preparation: comma-separated bank IDs, local cut-off, and the service identity that submits (people approve).
CBS_BATCH_BANKS=
CBS_BATCH_PREPARE_AFTER=18:00
CBS_BATCH_SERVICE_ISSUER=
CBS_BATCH_SERVICE_SUBJECT=
CBS_PORTAL_CLIENT_ID=
CBS_PORTAL_REDIRECT_URI=http://127.0.0.1:8080/admin/index.html
CBS_PORTAL_SCOPE=openid profile email

# Optional Safaricom M-Pesa sandbox only. Use a fictional test bank.
# These values must be provided to the application process; this file is not auto-loaded.
CBS_PAYMENTS_MPESA_ENABLED=false
CBS_PAYMENTS_MPESA_BANK_ID=
CBS_PAYMENTS_MPESA_SETTLEMENT_LEDGER_ID=
CBS_PAYMENTS_MPESA_SHORTCODE=
CBS_PAYMENTS_MPESA_CONSUMER_KEY=
CBS_PAYMENTS_MPESA_CONSUMER_SECRET=
CBS_PAYMENTS_MPESA_INITIATOR=
CBS_PAYMENTS_MPESA_SECURITY_CREDENTIAL=
CBS_PAYMENTS_MPESA_CALLBACK_BASE=
