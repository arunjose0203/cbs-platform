{
    email {$ACME_EMAIL}
    admin off
}
{$CBS_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
    # The largest API body is a 1 MiB statement CSV inside JSON; refuse anything far larger at the edge.
    request_body {
        max_size 8MB
    }
    handle /health/ready {
        rewrite * /actuator/health/readiness
        reverse_proxy app:8080
    }
    handle /actuator/* {
        respond 404
    }
    handle {
        reverse_proxy app:8080
    }
}
